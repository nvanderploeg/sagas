{
	"name": "web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"build:mcp-ui": "vite build --config vite.mcp-ui.config.ts && mv src/lib/server/mcp/ui/index.html src/lib/server/mcp/ui/board.html",
		"dev": "pnpm build:mcp-ui && vite dev",
		"build": "pnpm build:mcp-ui && vite build",
		"preview": "vite preview",
		"check": "pnpm build:mcp-ui && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "pnpm build:mcp-ui && vitest run",
		"db:generate": "drizzle-kit generate",
		"models:fetch": "node scripts/fetch-model.js"
	},
	"devDependencies": {
		"@modelcontextprotocol/ext-apps": "^2.0.4",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/markdown-it": "^14.2.0",
		"@types/node": "^22",
		"drizzle-kit": "^0.31.11",
		"standardwebhooks": "^1.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vite-plugin-singlefile": "^2.3.4",
		"vitest": "^5.0.4"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@huggingface/transformers": "^4.3.1",
		"@modelcontextprotocol/sdk": "^1.32.1",
		"@node-rs/argon2": "^2.2.2",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.4",
		"fractional-indexing": "3.2.0",
		"markdown-it": "^14.3.2",
		"zod": "^4.6.7"
	}
}
