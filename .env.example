# Local development: the database file for `pnpm --filter web dev`.
DATABASE_PATH=./data/sagas.db

# docker-compose: the host port.
SAGAS_PORT=3290

# docker-compose: the headers a TLS reverse proxy sets to pass on the original protocol and host.
# Without them a request is plain http at its Host header. Set one empty to ignore that header.
SAGAS_PROTOCOL_HEADER=x-forwarded-proto
SAGAS_HOST_HEADER=x-forwarded-host

# How long the live Stream can replay Events, in days.
EVENT_RETENTION_DAYS=7

# How long a Survey is kept with its results, in days.
SURVEY_RETENTION_DAYS=30

# How often an open Stream sends a heartbeat comment, in milliseconds.
STREAM_HEARTBEAT_MS=25000

# `pnpm --filter web models:fetch` fills it; the server never downloads a model.
EMBEDDING_MODEL_DIR=./models

# ONNX threads for the embedding worker.
EMBEDDING_THREADS=2

# 32 bytes in base64 that encrypt Webhook secrets; unset turns Webhooks off. `openssl rand -base64 32`
WEBHOOK_KEY=

# Webhooks one User may own, and Webhooks on the instance.
WEBHOOK_MAX_PER_USER=10
WEBHOOK_MAX=50

# `true` allows http and private addresses as Webhook targets.
WEBHOOK_ALLOW_PRIVATE=false
